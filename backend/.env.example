# Aplicação
NODE_ENV=development
PORT=3001
API_PREFIX=api/v1
CORS_ORIGIN=http://localhost:3000

# PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/anpg_operations?schema=public"

# Segurança
JWT_SECRET="trocar-este-segredo-em-producao"
JWT_EXPIRES_IN="1d"
BCRYPT_SALT_ROUNDS=10

# Uploads
UPLOAD_DIR="uploads"
MAX_UPLOAD_MB=25
